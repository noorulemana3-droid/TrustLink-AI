PORT=5000
NODE_ENV=development

# Local development (default)
MONGODB_URI=mongodb://127.0.0.1:27017/trustlink-ai

# Production later: MongoDB Atlas URI via environment variable (do not commit it)

JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

ADMIN_EMAIL=
ADMIN_PASSWORD=

OPENAI_API_KEY=
GEMINI_API_KEY=

# Sentry error tracking (https://sentry.io → project DSN)
SENTRY_DSN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password-reset sender. Local: Gmail App Password via SMTP works.
# Railway Hobby/Free blocks SMTP — use a free HTTPS API instead:
# 1. Sign up at https://app.brevo.com with the TrustLink Gmail
# 2. Create an API key: https://app.brevo.com/settings/keys/api
# 3. Set BREVO_API_KEY on Railway (and SMTP_USER = that Gmail)
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
